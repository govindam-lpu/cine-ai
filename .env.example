# Cinerex — environment template. Copy to `.env` and fill in. Real `.env` is gitignored.
# The app boots with the optional/production-only keys left blank (local dev uses Ollama + SQLite).

# --- TMDB enrichment ---
# Required for real ingestion. Absent keys degrade gracefully (no crash at import).
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3

# --- Database ---
# Local: SQLite file (default). Production: a Turso libSQL URL, e.g.
#   sqlite+libsql://<db>-<org>.turso.io/?authToken=<token>&secure=true
DATABASE_URL=sqlite:///./cinerex.db

# --- Writer backend (prose generation only) ---
# ollama = local dev, groq = production. Chosen at runtime.
WRITER_BACKEND=ollama
GROQ_API_KEY=                       # production only; create free at console.groq.com
OLLAMA_HOST=http://localhost:11434

# --- CORS: comma-separated frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend → backend base URL ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
